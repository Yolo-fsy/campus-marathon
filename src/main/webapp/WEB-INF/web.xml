<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>校园马拉松报名系统</display-name>

    <!--
        覆盖 Tomcat 默认静态资源 Servlet。
        默认按平台编码（中文 Windows 为 GBK）读取文件，而 EncodingFilter 又把响应编码设为
        UTF-8，导致含中文的 CSS/JS 被 GBK→UTF-8 二次转码成乱码。显式声明按 UTF-8 读取即可。
    -->
    <servlet>
        <servlet-name>default</servlet-name>
        <servlet-class>org.apache.catalina.servlets.DefaultServlet</servlet-class>
        <init-param>
            <param-name>fileEncoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>useBomIfPresent</param-name>
            <param-value>true</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- 统一 UTF-8 编码 -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.campus.marathon.web.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 角色访问控制 -->
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.campus.marathon.web.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/my</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/my/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/apply</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/apply/*</url-pattern>
    </filter-mapping>
    <!-- AI 知识库：需登录后访问 -->
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/ai</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/ai/*</url-pattern>
    </filter-mapping>
    <!-- 数据分析看板：仅管理员访问 -->
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/analytics</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/analytics/*</url-pattern>
    </filter-mapping>
    <!-- 竞赛模块：需登录后访问 -->
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/contests</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/contests/*</url-pattern>
    </filter-mapping>

    <!-- 登录 / 退出 / 公开报名 -->
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>applyServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ApplyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>applyServlet</servlet-name>
        <url-pattern>/apply</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>applyServlet</servlet-name>
        <url-pattern>/apply/form</url-pattern>
    </servlet-mapping>

    <!-- 参赛者个人中心 -->
    <servlet>
        <servlet-name>myRegistrationServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.MyRegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>myRegistrationServlet</servlet-name>
        <url-pattern>/my</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>myEditServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.MyEditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>myEditServlet</servlet-name>
        <url-pattern>/my/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>mySaveServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.MySaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>mySaveServlet</servlet-name>
        <url-pattern>/my/save</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>myCancelServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.MyCancelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>myCancelServlet</servlet-name>
        <url-pattern>/my/cancel</url-pattern>
    </servlet-mapping>

    <!-- 报名费支付（支付宝沙箱） -->
    <servlet>
        <servlet-name>payServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.PayServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>payServlet</servlet-name>
        <url-pattern>/pay</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>payReturnServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.PayReturnServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>payReturnServlet</servlet-name>
        <url-pattern>/pay/return</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>payNotifyServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.PayNotifyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>payNotifyServlet</servlet-name>
        <url-pattern>/pay/notify</url-pattern>
    </servlet-mapping>

    <!-- 管理员报名管理 -->
    <servlet>
        <servlet-name>registrationListServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegistrationListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registrationListServlet</servlet-name>
        <url-pattern>/admin/registrations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registrationDetailServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegistrationDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registrationDetailServlet</servlet-name>
        <url-pattern>/admin/registrations/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registrationFormServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegistrationFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registrationFormServlet</servlet-name>
        <url-pattern>/admin/registrations/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registrationSaveServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegistrationSaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registrationSaveServlet</servlet-name>
        <url-pattern>/admin/registrations/save</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registrationDeleteServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegistrationDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registrationDeleteServlet</servlet-name>
        <url-pattern>/admin/registrations/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>adminReviewServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.AdminReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminReviewServlet</servlet-name>
        <url-pattern>/admin/registrations/review</url-pattern>
    </servlet-mapping>

    <!-- AI 知识库问答 -->
    <servlet>
        <servlet-name>kbListServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.KbListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>kbListServlet</servlet-name>
        <url-pattern>/ai</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>kbUploadServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.KbUploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>kbUploadServlet</servlet-name>
        <url-pattern>/ai/upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>kbDeleteServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.KbDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>kbDeleteServlet</servlet-name>
        <url-pattern>/ai/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>kbChatPageServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.KbChatPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>kbChatPageServlet</servlet-name>
        <url-pattern>/ai/chat</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>kbAskServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.KbAskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>kbAskServlet</servlet-name>
        <url-pattern>/ai/ask</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <!-- 参赛者账号注册与图形验证码 -->
    <servlet>
        <servlet-name>registerServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registerServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>captchaServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.CaptchaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>captchaServlet</servlet-name>
        <url-pattern>/register/captcha</url-pattern>
    </servlet-mapping>

    <!-- ========== 竞赛管理系统 ========== -->

    <servlet>
        <servlet-name>contestListServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestListServlet</servlet-name>
        <url-pattern>/contests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contestFormServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestFormServlet</servlet-name>
        <url-pattern>/contests/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contestJudgeServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestJudgeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestJudgeServlet</servlet-name>
        <url-pattern>/contests/judges</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contestCriterionServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestCriterionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestCriterionServlet</servlet-name>
        <url-pattern>/contests/criteria</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contestantListServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestantListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestantListServlet</servlet-name>
        <url-pattern>/contests/contestants</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contestRankServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.ContestRankServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contestRankServlet</servlet-name>
        <url-pattern>/contests/rank</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>judgeLoginServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.JudgeLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>judgeLoginServlet</servlet-name>
        <url-pattern>/judge/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>judgeScoringServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.JudgeScoringServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>judgeScoringServlet</servlet-name>
        <url-pattern>/judge/score</url-pattern>
    </servlet-mapping>

    <!-- ========== 报名数据分析看板 ========== -->

    <servlet>
        <servlet-name>analyticsPageServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.AnalyticsPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>analyticsPageServlet</servlet-name>
        <url-pattern>/analytics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>analyticsDataServlet</servlet-name>
        <servlet-class>com.campus.marathon.web.AnalyticsDataServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>analyticsDataServlet</servlet-name>
        <url-pattern>/analytics/data</url-pattern>
    </servlet-mapping>

</web-app>